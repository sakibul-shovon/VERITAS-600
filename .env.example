# ==============================================================================
# VERITAS-600 Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL 16 (Operational Database: lc_master, lc_amendments, audit_logs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=veritas
POSTGRES_PASSWORD=veritas_secret_change_me
POSTGRES_DB=trade_finance

# Redis 7 (Token bucket rate limiter & ZTRV nonce cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Mandatory Sponsor Integrations
# ------------------------------------------------------------------------------

# 1. Zetaris (Federated Data Layer)
# If empty or unreachable, the system automatically runs in LOCAL_DUCKDB_FALLBACK
ZETARIS_BASE_URL=https://api.zetaris.cloud/v1
ZETARIS_API_KEY=your_zetaris_api_key_here
ZETARIS_EXECUTION_MODE=AUTO # Options: AUTO, FORCE_LIVE, FORCE_FALLBACK

# 2. Meterless (Context Routing & Stateful Memory)
METERLESS_BASE_URL=https://api.meterless.ai/v1
METERLESS_API_KEY=your_meterless_api_key_here

# 3. NVIDIA Nemotron (Inference via NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your_nvidia_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NEMOTRON_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NEMOTRON_FAST_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
NIM_RATE_LIMIT_RPM=25
ENABLE_RESPONSE_CACHE=true

# ------------------------------------------------------------------------------
# Security & Verification
# ------------------------------------------------------------------------------
SECRET_KEY=change_me_to_a_secure_random_string_in_production
ZTRV_HMAC_SECRET=veritas_zero_trust_runtime_hmac_secret
